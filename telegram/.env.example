# Copy this file to .env and fill in real values. Never commit .env.

# BotFather token for TippyWiraHijauBot.
TELEGRAM_BOT_TOKEN=

# Railway PostgreSQL (or local). Do not put real passwords in this example file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Public bot username (no @) — must match the web app TELEGRAM_BOT_USERNAME.
TELEGRAM_BOT_USERNAME=TippyWiraHijauBot
